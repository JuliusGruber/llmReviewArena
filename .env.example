# Copy this file to .env and fill in your API keys
# The .env file is automatically loaded at startup - no need to source manually
#
# NOTE: Do NOT use 'export ' prefix - use standard dotenv format: KEY=value

# Anthropic API key (for Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API key (for Codex)
OPENAI_API_KEY=sk-your-key-here

# Google API key (for Gemini) - use either GEMINI_API_KEY or GOOGLE_API_KEY
GEMINI_API_KEY=your-key-here
# GOOGLE_API_KEY=your-key-here
